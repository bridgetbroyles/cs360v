### Config.uk: Kconfig option for the statistics library.
#
# Declaring an option here lets Makefile.uk compile your library's source only
# when the option is true.
#
# See SPEC.md Part III.
#
# Your Makefile.uk then guards the library's sources with
# $(CONFIG_APPRUNNER_STATS).

# TODO (implemented): declare the statistics-library build option.
config APPRUNNER_STATS
	bool "Collect unikernel statistics (boot time, invocations)"
	default y
	help
	  Builds libukstats, which records when boot finished, counts the
	  invocations the runner serves, and answers INFO from inside the
	  unikernel.
